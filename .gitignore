# PlatformIO / build
.pio
.cache
compile_commands.json

# Node / µGulp
node_modules/
.microgulp/
npm-debug.log*
package-lock.json.bak

# Local NAS targets (never commit real paths)
config/nas.targets.local
.env
.env.*
!.env.example
!.env.*.example

# Secrets / credentials / private keys
*.pem
*.key
*.p12
*.pfx
*credentials*
*secrets*
.settings_private*
settings_private.*

# IDE caches
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/*.log
.idea/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local refs / vendor dumps (NOT Git — YES private NAS backup)
# See docs/backup/nas-policy.md — gitignore ≠ NAS policy.
*_refs
_refs/
_physical/

# Local / vendor mechanical assets under 3dprint (NAS-backed; redistribution often unclear)
3dprint/**/vendor/
3dprint/**/local/
3dprint/cad/step/**
!3dprint/cad/step/README.md
3dprint/cad/parasolid/**
!3dprint/cad/parasolid/README.md
3dprint/plasticity/**
!3dprint/plasticity/README.md
3dprint/printable/**
!3dprint/printable/README.md
3dprint/prototypes/**
!3dprint/prototypes/README.md
*.plasticity

# Non-redistributable hardware evidence drops (tracked evidence stays in evidence/)
docs/hardware/evidence/local/

# Transient logs
*_log.txt
build_log.txt
upload_log.txt
monitor_log.txt
pkg_install_log.txt

# Verified release artifacts may live in releases/ (Git policy separate; NAS-backed)
# Do not put transient .pio/build output here.

# ESP-IDF / PlatformIO generated sdkconfig (per-env + defaults copy)
sdkconfig
sdkconfig.old
sdkconfig.defaults
sdkconfig.t-lion-idf-spike
sdkconfig.t-lion-idf-spike-classic
sdkconfig.t-lion-idf-spike-ble
sdkconfig.t-lion-idf-spike-a2dp
sdkconfig.t-lion-idf-spike-triple
sdkconfig.t-lion-idf-debug
sdkconfig.t-lion-idf-release

# Python
*.pyc
__pycache__/

# clangd / tooling
.clangd
.cache/
