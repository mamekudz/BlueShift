{
  "name": "blueshift",
  "version": "0.5.0-dev",
  "license": "SEE LICENSE.md",
  "private": true,
  "description": "BlueShift — Bringing Classic Bluetooth into the BLE era (µGulp / Gulp task runner)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "help": "gulp help",
    "docs": "gulp docs",
    "format": "gulp format",
    "format:check": "gulp format:check",
    "check": "gulp check",
    "backup": "gulp backup",
    "backup:git": "gulp backup:git",
    "backup:nas": "gulp backup:nas",
    "backup:all": "gulp backup:all",
    "test:infra": "node --test dev/tools/infra.test.mjs",
    "test:host": "node --test dev/tools/host_logic.test.mjs",
    "test:audio": "node --test dev/tools/audio_pipeline.test.mjs",
    "test:protocol": "node --test dev/tools/protocol_v1_golden.test.mjs",
    "test:host:native": "pio run -e native",
    "test": "npm run test:infra && npm run test:host && npm run test:audio && npm run test:protocol",
    "gulp:tasks": "gulp --tasks"
  },
  "microgulp": {
    "ready": true
  },
  "devDependencies": {
    "gulp": "^5.0.0",
    "gulp-mu-gulp-api": "^0.5.0"
  }
}
